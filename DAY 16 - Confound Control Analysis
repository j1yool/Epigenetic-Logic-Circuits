import os
os.environ["OMP_NUM_THREADS"] = "1"
os.environ["MKL_NUM_THREADS"] = "1"
os.environ["OPENBLAS_NUM_THREADS"] = "1"

import pandas as pd
import numpy as np
from sklearn.linear_model import LogisticRegression
from sklearn.model_selection import StratifiedKFold, cross_val_score
from sklearn.preprocessing import OneHotEncoder

np.random.seed(42)

binary = pd.read_csv(r"data\k562\k562_binary_matrix.csv")
gates = pd.read_csv(r"data\k562\k562_gate_assignments_named.tsv", sep="\t")
df = binary.merge(gates, on="gene_id")

orig_rate = df["expressed"].mean()
print(f"Original K562 positive rate: {orig_rate:.3f}")

# Downsample negatives so positive rate matches GM12878 (0.548)
target_rate = 0.548
pos = df[df["expressed"] == 1]
neg = df[df["expressed"] == 0]
n_neg_target = int(len(pos) * (1 - target_rate) / target_rate)
neg_downsampled = neg.sample(n=n_neg_target, random_state=42)

df_bal = pd.concat([pos, neg_downsampled]).sample(frac=1, random_state=42).reset_index(drop=True)
print(f"Balanced set size: {len(df_bal)}, positive rate: {df_bal['expressed'].mean():.3f}")

ohe = OneHotEncoder(sparse_output=False, handle_unknown="ignore")
X_gate = ohe.fit_transform(df_bal[["gate_type"]])
y = df_bal["expressed"].values

clf = LogisticRegression(solver="liblinear", max_iter=1000)
cv = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)
auc_scores = cross_val_score(clf, X_gate, y, cv=cv, scoring="roc_auc")

print(f"Balanced-resample Model 2 AUC: {auc_scores.mean():.4f} (+/- {auc_scores.std():.4f})")
print(f"Original Model 2 AUC (full imbalanced K562): 0.9986")