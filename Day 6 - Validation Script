"""
Block 2 — step4_validate_gates.py  (Parts A and B)
Part A: Landmark validation table with PASS/FAIL scoring
Part B: Population-level sanity checks (expression by gate type, Mann-Whitney U,
        complexity ordering, NULL expression floor)

Run from: C:\\Users\\jamoo\\Downloads\\LOGIC CIRCUITS\\
Outputs:
  - validation_report_day6.txt   (full printed report)
  - Printed summary to console
"""

import os
import sys
import pandas as pd
import numpy  as np
from scipy.stats import mannwhitneyu

# ── paths ─────────────────────────────────────────────────────────────────────
BASE_DIR  = r"C:\Users\jamoo\Downloads\LOGIC CIRCUITS"
GATE_FILE = os.path.join(BASE_DIR, "data", "gate_assignments_mapped.tsv")
OUT_FILE  = os.path.join(BASE_DIR, "validation_report_day6.txt")

# ── landmark definitions ───────────────────────────────────────────────────────
LANDMARKS = {
    "BIVALENT":   ["HOXA1", "HOXA5", "HOXA9", "HOXA10", "HOXB4", "PAX5", "GATA2"],
    "SIMPLE_AND": ["GAPDH", "ACTB", "B2M", "HPRT1", "RPL13A"],
    "REPRESSED":  ["CDH1", "HBB"],
    "NULL":       ["OR4F5", "OR4F29"],
}

# ── load data ─────────────────────────────────────────────────────────────────
if not os.path.isfile(GATE_FILE):
    sys.exit(f"ERROR: {GATE_FILE} not found.")

df = pd.read_csv(GATE_FILE, sep="\t")
df.columns = [c.strip().lower() for c in df.columns]

# ── resolve column names ───────────────────────────────────────────────────────
def find_col(df, candidates, label):
    for c in candidates:
        if c in df.columns:
            return c
    sys.exit(f"ERROR: Could not find '{label}' column. Columns present: {list(df.columns)}")

gene_col       = find_col(df, ["gene_name","gene","gene_id","symbol"],           "gene name")
gate_col       = find_col(df, ["gate","gate_type","gate_call"],                  "gate type")
complexity_col = find_col(df, ["complexity","complexity_score","complexity score"], "complexity")

# Expression column — soft fail: Part B checks will be skipped if absent
expr_col = None
for c in ["tpm","expression","expr","mean_tpm","mean_expression","log2_tpm"]:
    if c in df.columns:
        expr_col = c
        break

df["_gene_upper"] = df[gene_col].str.upper()

lines = []

# ══════════════════════════════════════════════════════════════════════════════
#  PART A — LANDMARK VALIDATION TABLE
# ══════════════════════════════════════════════════════════════════════════════
lines.append("=" * 72)
lines.append("PART A — LANDMARK VALIDATION TABLE")
lines.append("=" * 72)
lines.append("")

records = []   # (gene, expected, actual, complexity, pass_fail)

for expected_gate, genes in LANDMARKS.items():
    lines.append(f"  Expected: {expected_gate}")
    lines.append(f"  {'GENE':<12}  {'EXPECTED':<14}  {'ACTUAL':<22}  {'COMPLEXITY':>11}  RESULT")
    lines.append("  " + "-" * 68)

    for gene in genes:
        row = df[df["_gene_upper"] == gene.upper()]
        if row.empty:
            lines.append(f"  {gene:<12}  {expected_gate:<14}  {'NOT FOUND':<22}  {'N/A':>11}  ⚠ MISSING")
            records.append((gene, expected_gate, "NOT FOUND", None, "MISSING"))
            continue

        actual = str(row.iloc[0][gate_col])
        compl  = row.iloc[0][complexity_col]
        passed = actual.upper() == expected_gate.upper()
        result = "✓ PASS" if passed else "✗ FAIL"
        lines.append(f"  {gene:<12}  {expected_gate:<14}  {actual:<22}  {compl:>11.4f}  {result}")
        records.append((gene, expected_gate, actual, compl, result))

    lines.append("")

# accuracy
found   = [r for r in records if r[4] != "MISSING"]
passed  = [r for r in found   if "PASS" in r[4]]
missing = [r for r in records if r[4] == "MISSING"]
accuracy = len(passed) / len(found) * 100 if found else 0.0

lines.append("-" * 72)
lines.append(f"  Genes queried : {sum(len(v) for v in LANDMARKS.values())}")
lines.append(f"  Found         : {len(found)}")
lines.append(f"  PASS          : {len(passed)}")
lines.append(f"  FAIL          : {len(found) - len(passed)}")
lines.append(f"  MISSING       : {len(missing)}")
lines.append(f"  Accuracy      : {accuracy:.1f}%")
threshold_met = accuracy >= 70
lines.append(f"  70% threshold : {'✓ MET — proceed' if threshold_met else '✗ NOT MET — adjust thresholds'}")
lines.append("")

if missing:
    lines.append(f"  Missing genes: {', '.join(r[0] for r in missing)}")
    lines.append("  Check TSV for alternate gene symbols.")
    lines.append("")

if not threshold_met:
    lines.append("DIAGNOSTIC HINTS (failed landmarks):")
    for gene, exp, act, _, res in found:
        if "FAIL" in res:
            if exp == "BIVALENT" and "AND" in act.upper():
                lines.append(f"  {gene}: got {act} not BIVALENT → raise H3K27me3 threshold.")
            elif exp == "SIMPLE_AND":
                lines.append(f"  {gene}: got {act} not SIMPLE_AND → check TSS peak-assignment window.")
            elif exp == "REPRESSED":
                lines.append(f"  {gene}: got {act} not REPRESSED → verify H3K27me3 / H3K9me3 coverage.")
            elif exp == "NULL":
                lines.append(f"  {gene}: got {act} not NULL → olfactory locus may have spurious peaks.")
    lines.append("")

# ══════════════════════════════════════════════════════════════════════════════
#  PART B — POPULATION-LEVEL SANITY CHECKS
# ══════════════════════════════════════════════════════════════════════════════
lines.append("=" * 72)
lines.append("PART B — POPULATION-LEVEL SANITY CHECKS")
lines.append("=" * 72)
lines.append("")

gate_upper = df[gate_col].str.upper()

# Check 1 — Mean expression by gate type
lines.append("CHECK 1: Mean expression (TPM) by gate type")
if expr_col is None:
    lines.append("  ⚠ No expression column found in gate_assignments.tsv.")
    lines.append("  Columns present: " + ", ".join(df.columns.tolist()))
    lines.append("  Skipping expression-based checks.")
    lines.append("  → If you have a separate TPM file, merge it by gene_name and rerun.")
    lines.append("")
    skip_expr = True
else:
    skip_expr = False
    expr_by_gate = df.groupby(gate_col)[expr_col].mean().sort_values(ascending=False)
    lines.append(f"  {'GATE TYPE':<25}  {'MEAN TPM':>12}  {'N GENES':>8}")
    lines.append("  " + "-" * 50)
    for gate, mean_val in expr_by_gate.items():
        n = (gate_upper == str(gate).upper()).sum()
        lines.append(f"  {str(gate):<25}  {mean_val:>12.4f}  {n:>8}")
    lines.append("")

# Check 2 — Mann-Whitney U: SIMPLE_AND vs REPRESSED expression
lines.append("CHECK 2: SIMPLE_AND vs REPRESSED expression (Mann-Whitney U)")
if skip_expr:
    lines.append("  ⚠ Skipped — no expression column.\n")
else:
    and_expr = df.loc[gate_upper == "SIMPLE_AND", expr_col].dropna()
    rep_expr = df.loc[gate_upper == "REPRESSED",  expr_col].dropna()
    if len(and_expr) < 2 or len(rep_expr) < 2:
        lines.append(f"  ⚠ Too few genes in one group (SIMPLE_AND n={len(and_expr)}, REPRESSED n={len(rep_expr)}).")
        lines.append("  Cannot run Mann-Whitney U. Check gate assignments.\n")
    else:
        stat, p = mannwhitneyu(and_expr, rep_expr, alternative="greater")
        result  = "✓ PASS" if p < 0.001 else "✗ FAIL (p ≥ 0.001)"
        lines.append(f"  SIMPLE_AND n={len(and_expr)}, mean TPM = {and_expr.mean():.4f}")
        lines.append(f"  REPRESSED  n={len(rep_expr)}, mean TPM = {rep_expr.mean():.4f}")
        lines.append(f"  U={stat:.0f}, p={p:.2e}  →  {result}")
        lines.append("")

# Check 3 — Complexity ordering: BIVALENT > SIMPLE_AND
lines.append("CHECK 3: Mean complexity — BIVALENT > SIMPLE_AND")
biv_compl = df.loc[gate_upper == "BIVALENT",   complexity_col].dropna()
and_compl = df.loc[gate_upper == "SIMPLE_AND", complexity_col].dropna()
if len(biv_compl) < 2 or len(and_compl) < 2:
    lines.append(f"  ⚠ Too few genes (BIVALENT n={len(biv_compl)}, SIMPLE_AND n={len(and_compl)}).\n")
else:
    biv_mean = biv_compl.mean()
    and_mean = and_compl.mean()
    result   = "✓ PASS" if biv_mean > and_mean else "✗ FAIL"
    lines.append(f"  BIVALENT   mean complexity = {biv_mean:.4f}  (n={len(biv_compl)})")
    lines.append(f"  SIMPLE_AND mean complexity = {and_mean:.4f}  (n={len(and_compl)})")
    lines.append(f"  BIVALENT > SIMPLE_AND: {result}")
    lines.append("")

# Check 4 — NULL genes have lowest mean expression
lines.append("CHECK 4: NULL genes have lowest mean expression")
if skip_expr:
    lines.append("  ⚠ Skipped — no expression column.\n")
else:
    null_expr = df.loc[gate_upper == "NULL", expr_col].dropna()
    min_gate  = expr_by_gate.idxmin()
    result    = "✓ PASS" if str(min_gate).upper() == "NULL" else f"✗ FAIL (lowest is {min_gate})"
    lines.append(f"  NULL mean TPM = {null_expr.mean():.4f}  (n={len(null_expr)})")
    lines.append(f"  Gate with lowest mean expression: {min_gate}  →  {result}")
    lines.append("")

# ── complexity summary table (always runs) ─────────────────────────────────────
lines.append("COMPLEXITY SCORE SUMMARY BY GATE TYPE")
lines.append(f"  {'GATE TYPE':<25}  {'MEAN COMPLEXITY':>16}  {'N GENES':>8}")
lines.append("  " + "-" * 55)
compl_by_gate = df.groupby(gate_col)[complexity_col].mean().sort_values(ascending=False)
for gate, mean_val in compl_by_gate.items():
    n = (gate_upper == str(gate).upper()).sum()
    lines.append(f"  {str(gate):<25}  {mean_val:>16.4f}  {n:>8}")
lines.append("")

# ── write output ───────────────────────────────────────────────────────────────
lines.append("=" * 72)
lines.append(f"LANDMARK ACCURACY: {accuracy:.1f}%  |  70% THRESHOLD: {'MET ✓' if threshold_met else 'NOT MET ✗'}")
lines.append("=" * 72)

output = "\n".join(lines)
print(output)

with open(OUT_FILE, "w", encoding="utf-8") as fh:
    fh.write(output)

print(f"\nFull report saved to: {OUT_FILE}")